# .env файл для локальной разработки
# Скопируйте этот файл в .env и заполните своими данными

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# OpenAI API Key (получить на platform.openai.com)
OPENAI_API_KEY=sk-your-openai-api-key-here

# PostgreSQL Database URL 
# Для Docker: postgresql://gena_user:gena_password_secure_123@db:5432/gena_valet_bot
# Для локально: postgresql://gena_user:gena_password_secure_123@localhost:5432/gena_valet_bot
DATABASE_URL=postgresql://gena_user:gena_password_secure_123@db:5432/gena_valet_bot

# Telegram ID админов (узнать через @userinfobot, можно несколько через запятую)
ADMIN_IDS=123456789

# CryptoBot Token (опционально, для приёма платежей в криптовалюте)
CRYPTOBOT_TOKEN=

# Ссылки на проект (замените на реальные)
PROJECT_CHANNEL=https://t.me/gena_valet_channel
PROJECT_WEBSITE=https://gena-valet.ru
